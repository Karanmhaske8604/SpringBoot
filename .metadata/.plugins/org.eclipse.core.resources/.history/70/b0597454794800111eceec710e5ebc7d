package com.hospital.apollo.ControllerLayer;



import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RestController;


import com.hospital.apollo.DTO.PatientDTO2;
import com.hospital.apollo.Entity.Patient;
import com.hospital.apollo.ServiceLayer.PatienService;

@RestController
public class PateintController {
	
	@Autowired
	public PatienService service;
	
	@PostMapping("/patient/add")
	public String addPatient(@RequestBody List<Patient> pat)
	{
		return service.add(pat);
	}
	
	@GetMapping("/patient/get")
	public List<PatientDTO2> getPatient()
	{
		return service.getpatient();
	}

	

}
